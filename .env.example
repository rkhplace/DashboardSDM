GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Opsional: model cadangan bila model utama terus sibuk (HTTP 5xx), mis. gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Opsional: batas request /api/chat per IP per menit (default 20)
CHAT_RATE_LIMIT=20
# Opsional: origin tambahan yang boleh memanggil /api/chat, pisahkan dengan koma
CHAT_ALLOWED_ORIGINS=
